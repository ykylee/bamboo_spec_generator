{
  "buildId": "sample-python-batch",
  "name": "Sample Python Batch",
  "planKey": "SAMPPYA",
  "description": "Sample Python Batch build plan",
  "language": "python",
  "compiler": "python",
  "repository": {
    "provider": "bitbucket",
    "projectKey": "PYAUTO",
    "repoSlug": "sample-python-batch",
    "linkageMode": "linked",
    "branches": [
      "dev",
      "release",
      "master"
    ]
  },
  "requirements": {
    "os": "linux",
    "extraCapabilities": []
  },
  "build": {
    "subPath": "jobs/sample-python-batch",
    "prepareCommand": "python3 -m pip install -r requirements.txt",
    "buildCommand": "python3 -m pytest",
    "staticAnalysis": {
      "customTool": {
        "commands": [
          "python3 scripts/custom_tool.py init --python",
          "custom-tool analyze {buildCommand}",
          "python3 scripts/custom_tool.py publish --python"
        ]
      }
    },
    "runtimeRequirements": {
      "commands": [
        "python3",
        "pip",
        "pytest",
        "coverity",
        "custom-tool",
        "trigger-plan"
      ],
      "envVars": [
        "PATH",
        "PIP_INDEX_URL"
      ]
    },
    "postBuildTrigger": {
      "type": "plan",
      "targetPlanKey": "POSTPYA"
    }
  }
}
