{
  "buildId": "sample-app-mfc",
  "name": "Sample App MFC",
  "planKey": "SAMPMFC",
  "description": "Sample App MFC build plan for Visual Studio 2022",
  "language": "cpp",
  "compiler": "vs2022",
  "repository": {
    "provider": "bitbucket",
    "projectKey": "SAMPLE",
    "repoSlug": "sample-app-mfc",
    "linkageMode": "linked",
    "branches": [
      "dev",
      "release",
      "master"
    ]
  },
  "requirements": {
    "os": "windows",
    "extraCapabilities": [
      "nuget"
    ]
  },
  "build": {
    "subPath": "src/SampleAppMfc",
    "prepareCommand": "nuget restore SampleAppMfc.sln",
    "buildCommand": "msbuild SampleAppMfc.sln /p:Configuration=Release /p:Platform=x64",
    "staticAnalysis": {
      "customTool": {
        "commands": [
          "python scripts/custom_tool.py init --windows-native",
          "custom-tool analyze {buildCommand}",
          "python scripts/custom_tool.py publish --windows-native"
        ]
      }
    },
    "runtimeRequirements": {
      "commands": [
        "python",
        "nuget",
        "msbuild",
        "coverity",
        "custom-tool",
        "trigger-plan"
      ],
      "envVars": [
        "PATH",
        "VS2022_ENV"
      ]
    },
    "postBuildTrigger": {
      "type": "plan",
      "targetPlanKey": "POSTMFC"
    }
  }
}
