# Database
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bamboo_meta
DATABASE_MAX_CONNECTIONS=5

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Auth
API_TOKEN=your-secure-token-here

# External Services
BAMBOO_URL=http://127.0.0.1:8085
BAMBOO_USER=admin
BAMBOO_TOKEN=your-bamboo-token
JENKINS_URL=http://127.0.0.1:8080
JENKINS_USER=admin
JENKINS_TOKEN=your-jenkins-token

# Logging
LOG_LEVEL=info
