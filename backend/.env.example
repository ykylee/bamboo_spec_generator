DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# sqlite or postgresql
BAMBOO_DB_ENGINE=sqlite

# Used when BAMBOO_DB_ENGINE=sqlite
BAMBOO_DB_SQLITE_NAME=db.sqlite3

# Used when BAMBOO_DB_ENGINE=postgresql
BAMBOO_DB_HOST=127.0.0.1
BAMBOO_DB_PORT=5432
BAMBOO_DB_USER=postgres
BAMBOO_DB_PASSWORD=replace-me
BAMBOO_DB_NAME=bamboo_meta
BAMBOO_DB_SSLMODE=disable

BAMBOO_API_TOKEN=replace-me
